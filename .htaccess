# HUMAYA · configuración para hosting Apache (SiteGround)
# Esto reemplaza lo que Vercel hacía solo: HTTPS, quitar el www, comprimir y cachear.

# ─────────────────────────────────────────────
# 1. Forzar HTTPS y quitar el www, en un solo salto
# ─────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si entra por http:// o con www., manda a https://stayhumaya.com
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ─────────────────────────────────────────────
# 2. Comprimir texto (el HTML pesa 76 KB y baja a ~15 KB)
# ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─────────────────────────────────────────────
# 3. Caché: las imágenes un año, el HTML nunca
#    (así un cambio en el sitio se ve de inmediato,
#     pero las fotos no se vuelven a bajar)
# ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Higiene básica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─────────────────────────────────────────────
# 4. Página de inicio
# ─────────────────────────────────────────────
DirectoryIndex index.html

# No listar carpetas si alguien entra a /assets/
Options -Indexes
