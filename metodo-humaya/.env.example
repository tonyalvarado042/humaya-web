# Mientras no exista backend, los servicios devuelven datos de ejemplo.
VITE_USE_MOCKS=true

# Base de las Edge Functions de Supabase. /entrada y el Concierge ya son
# reales (ver
# docs/ESTADO.md); el resto de los servicios sigue en mocks. Opcional: trae
# un valor por defecto que apunta al proyecto compartido de Humaya.
# VITE_SUPABASE_FN_URL=https://mlhhhwbgymobcxiklnoz.supabase.co/functions/v1

# ── La marca de esta instalación ────────────────────────────────────────
# Tony, 15 de noviembre de 2026: «más adelante venderemos esta app, así que
# cada hotel puede configurar el nombre del app y el domain».
#
# Sin estas variables, la app sale con la marca de Humaya. Un hotel que
# compre la app pone las suyas acá y no toca ni una pantalla.
# Viven en src/marca.ts, que es el único lugar donde se leen.
# VITE_MARCA_EXPERIENCIA=HUMAYA Experience
# VITE_MARCA_HOTEL=HUMAYA
# VITE_MARCA_CORREO=reservations@stayhumaya.com
